  "cards": [
    {
      "dot": "cyan",
      "title": "当前已有核心与 API",
      "items": [
        "CLI、HTTP 和远端 CLI 复用同一 Python 核心，提供稳定 JSON 结果与受控文件操作。",
        "电脑使用本地副本；NAS 调用方建议通过 --server 使用同一服务，部署仍待验收。"
      ]
    },
    {
      "dot": "violet",
      "title": "规范与 skill 随文件管理",
      "items": [
        ".kb/config.toml 绑定 note/source/project/task/daily 规范；模板生成，Schema 校验。",
        "完整 skill 包含程序与锁定依赖清单；Python 环境、安装登记和凭据留在库外。"
      ]
    },
    {
      "dot": "emerald",
      "title": "索引 fresh 与远端同步分开",
      "items": [
        "serve/watch 周期核验本地文件；search --fresh 检查本地哈希，不访问 Git 远端。",
        "检索返回路径、行号和文件哈希；状态区分结构、来源获取、审核有效性和任务执行。"
      ]
    },
    {
      "dot": "amber",
      "title": "跨设备使用显式 Git 同步",
      "items": [
        "电脑与 NAS 各自连接知识库远端；其他设备只能获得已提交、已推送且已拉取的内容。",
        "写入不自动提交推送；sync --commit-tools 仅处理日志可证明的工具修改，无后台调度。"
      ]
    },
    {
      "dot": "rose",
      "title": "写入与任务完成规则",
      "items": [
        "预期哈希、文件锁、原子替换与操作日志已实现；未知人工修改和分叉停止整合。",
        "用户完成待办保留审核状态，无需再次人工复核；agent 令牌不能冒充用户完成。"
      ]
    },
    {
      "dot": "slate",
      "title": "仍待交付的场景",
      "items": [
        "NAS 容器或系统服务托管、HTTPS、重启恢复及多设备持续运行需集成验收。",
        "Chrome 插件待开发，Hermes 待真实流程联调；MCP 和人工批准入口尚未实现。"
      ]
    }
  ]
